# secrets / local env — real secrets live on the server, never committed
.env
*.env

# dependencies & build artifacts
node_modules/
target/
.m2*/

# server runtime data — worlds, logs, generated plugin configs live on the box
server/data/

# bulky upstream client downloads (re-obtainable; the staged copies under clients/ ARE committed)
eaglerforge/
EaglercraftX_1.8_WASM-GC_Offline_Download.html

# imported world archives
cliff build*

# OS cruft
.DS_Store

# ClaudeBuild compiles against the live server jar (copied by build-plugin/build.sh)
build-plugin/lib/

# The Minecraft 26 client (~78MB single HTML) is staged by clients/stage-client-26.sh, not committed
clients/26/

# 26.x server runtime data + ClaudeBuild-26 build output
server26/data/
build-plugin-26/lib/
