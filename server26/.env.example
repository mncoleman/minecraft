# 26.x game-server secrets. Copy to .env (never commit .env).

# MUST equal mc-auth's MC_JWT_SECRET (same value as server/.env): one login
# gates both servers.
MC_JWT_SECRET=

# MUST equal mc-auth's MC_PRESENCE_TOKEN (same value as server/.env). Used for
# the presence endpoint and the current-username lookup against mc-auth.
MC_PRESENCE_TOKEN=

# This server's own RCON password (in-container port 25575, never published).
# MUST equal mc-auth's RCON26_PASSWORD. Generate: openssl rand -hex 24
RCON_PASSWORD=
